rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidStringList(val, maxItems) {
      return val is list
        && val.size() <= maxItems
        && (val.size() == 0 || val[0] is string);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'humorPreference', 'technicalDepth',
          'autonomyDecisiveness', 'likedTopics', 'dislikedTopics',
          'userVibe', 'totalLikes', 'totalDislikes', 'notes', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'name', 'city', 'humorPreference', 'technicalDepth',
          'autonomyDecisiveness', 'likedTopics', 'dislikedTopics',
          'userVibe', 'totalLikes', 'totalDislikes', 'notes',
          'slangTerms', 'preferredTheme', 'preferredPersona', 'preferredUseSearch',
          'voiceName', 'responseTone', 'responseLength', 'responseFormat',
          'responseUseEmojis', 'responseFontSize', 'customInstructions', 'updatedAt'
        ])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && data.humorPreference is bool
        && data.technicalDepth in ['high', 'balanced', 'simple']
        && data.autonomyDecisiveness is bool
        && data.userVibe in ['humorous', 'technical', 'direct', 'balanced']
        && isValidStringList(data.likedTopics, 30)
        && isValidStringList(data.dislikedTopics, 30)
        && isValidStringList(data.notes, 50)
        && (!('slangTerms' in data) || isValidStringList(data.slangTerms, 25))
        && (!('preferredTheme' in data) || data.preferredTheme in ['simple', 'cyber', 'nebula'])
        && (!('preferredPersona' in data) || data.preferredPersona in ['standard', 'cyber', 'code', 'concise'])
        && (!('preferredUseSearch' in data) || data.preferredUseSearch is bool)
        && (!('voiceName' in data) || data.voiceName in ['Kore', 'Zephyr', 'Charon', 'Fenrir'])
        && (!('responseTone' in data) || data.responseTone in ['friendly', 'professional', 'creative', 'didactic'])
        && (!('responseLength' in data) || data.responseLength in ['short', 'balanced', 'detailed'])
        && (!('responseFormat' in data) || data.responseFormat in ['rich', 'bullets', 'steps', 'plain'])
        && (!('responseUseEmojis' in data) || data.responseUseEmojis is bool)
        && (!('responseFontSize' in data) || data.responseFontSize in ['small', 'medium', 'large'])
        && (!('customInstructions' in data) || (data.customInstructions is string && data.customInstructions.size() <= 240))
        && data.totalLikes is number && data.totalLikes >= 0
        && data.totalDislikes is number && data.totalDislikes >= 0
        && data.updatedAt == request.time;
    }

    function isValidConversation(data, userId, convId) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'messages', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'title', 'messages', 'createdAt', 'updatedAt',
          'isFavorite', 'isArchived', 'projectId'
        ])
        && data.id == convId
        && isValidId(data.id)
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.messages is list && data.messages.size() <= 120
        && data.createdAt is number && data.createdAt >= 0
        && data.updatedAt is number && data.updatedAt >= 0
        && (!('isFavorite' in data) || data.isFavorite is bool)
        && (!('isArchived' in data) || data.isArchived is bool)
        && (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128));
    }

    function isValidProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'color', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'color', 'createdAt'])
        && data.id == projectId
        && isValidId(data.id)
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.color is string && data.color.size() >= 1 && data.color.size() <= 30
        && data.createdAt is number && data.createdAt >= 0;
    }

    function isValidReminder(data, userId, reminderId) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'completed', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'title', 'notes', 'dueAt', 'completed', 'sourceConvId', 'createdAt', 'updatedAt'
        ])
        && data.id == reminderId
        && isValidId(data.id)
        && data.ownerUid == userId
        && data.ownerUid == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('dueAt' in data) || data.dueAt == null || (data.dueAt is number && data.dueAt >= 0))
        && data.completed is bool
        && (!('sourceConvId' in data) || (data.sourceConvId is string && data.sourceConvId.size() <= 128))
        && data.createdAt is number && data.createdAt >= 0
        && data.updatedAt is number && data.updatedAt >= 0;
    }

    // Private PII, User Memory Profile & Synced Account Preferences (isolated per UID)
    match /users/{userId}/private/profile {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'name', 'city', 'humorPreference', 'technicalDepth',
          'autonomyDecisiveness', 'likedTopics', 'dislikedTopics',
          'userVibe', 'totalLikes', 'totalDislikes', 'notes',
          'slangTerms', 'preferredTheme', 'preferredPersona', 'preferredUseSearch',
          'voiceName', 'responseTone', 'responseLength', 'responseFormat',
          'responseUseEmojis', 'responseFontSize', 'customInstructions', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Synced User Conversations
    match /users/{userId}/conversations/{convId} {
      allow get: if isValidId(userId) && isValidId(convId) && isOwner(userId);
      allow list: if isValidId(userId)
        && isOwner(userId)
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(convId)
        && isOwner(userId)
        && isValidConversation(incoming(), userId, convId);
      allow update: if isValidId(userId)
        && isValidId(convId)
        && isOwner(userId)
        && isValidConversation(incoming(), userId, convId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'messages', 'updatedAt', 'isFavorite', 'isArchived', 'projectId'
        ]);
      allow delete: if isValidId(userId) && isValidId(convId) && isOwner(userId);
    }

    // Synced User Projects
    match /users/{userId}/projects/{projectId} {
      allow get: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
      allow list: if isValidId(userId)
        && isOwner(userId)
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(projectId)
        && isOwner(userId)
        && isValidProject(incoming(), userId, projectId);
      allow update: if isValidId(userId)
        && isValidId(projectId)
        && isOwner(userId)
        && isValidProject(incoming(), userId, projectId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color']);
      allow delete: if isValidId(userId) && isValidId(projectId) && isOwner(userId);
    }

    // Synced User Reminders
    match /users/{userId}/reminders/{reminderId} {
      allow get: if isValidId(userId) && isValidId(reminderId) && isOwner(userId);
      allow list: if isValidId(userId)
        && isOwner(userId)
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(reminderId)
        && isOwner(userId)
        && isValidReminder(incoming(), userId, reminderId);
      allow update: if isValidId(userId)
        && isValidId(reminderId)
        && isOwner(userId)
        && isValidReminder(incoming(), userId, reminderId)
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'notes', 'dueAt', 'completed', 'sourceConvId', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isValidId(reminderId) && isOwner(userId);
    }
  }
}
